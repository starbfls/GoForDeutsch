# Local configuration. Never paste real keys into chat or commit this file as .env.
AI_ENABLED=false
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional existing OpenAI provider: set AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Whole app attempts per UTC day, including judgement, hints and failed requests.
AI_DAILY_LIMIT=30
# Keep this value unchanged across restarts.
SECRET_KEY=
