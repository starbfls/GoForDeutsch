# Copy this file to backend/.env. Never paste your real key into chat or commit it.
# The fixed lessons work without any key. Live AI is opt-in for adult testing.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Counts API attempts across the local app per UTC day, including failed calls.
# This is a request-count guard, NOT a provider billing or currency limit.
AI_DAILY_LIMIT=30
# Set a long random value to keep account sessions valid across restarts.
SECRET_KEY=
