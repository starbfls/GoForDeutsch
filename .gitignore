# Environment files and secrets (at every directory level)
.env
.env.*
!.env.example
!.env.*.example
!.env.template

# Dependencies and Python bytecode
node_modules/
venv/
.venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/

# Local verification output, screenshots and browser profiles
/artifacts/

# Logs and temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Local editor and assistant preferences
.idea/
**/.vscode/*
!**/.vscode/extensions.json
.claude/settings.local.json

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini
